FROM python:3.11

WORKDIR /app

# Copies all sources before dependency install, so any code change busts cache
COPY . .

# Installs build tools and keeps package lists (extra size)
RUN apt-get update \
    && apt-get install -y build-essential curl

# Uses pip cache and no layer-friendly ordering
RUN pip install -r requirements.txt

EXPOSE 3001

# Dev-friendly but heavier runtime
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "3001", "--reload"]
